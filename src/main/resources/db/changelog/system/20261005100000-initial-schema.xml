<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <!-- chat_sessions — one row per conversation.
         Scoped to the tenant schema (t_{tenantKey}) by TenantLiquibaseRunner. -->
    <changeSet id="20261005100000-create-chat-sessions-table" author="iqkv">
        <createTable tableName="chat_sessions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)"/>
            <column name="model" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="chat_sessions" indexName="idx_chat_sessions_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="chat_sessions" indexName="idx_chat_sessions_updated_at">
            <column name="updated_at"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="chat_sessions" indexName="idx_chat_sessions_updated_at"/>
            <dropIndex tableName="chat_sessions" indexName="idx_chat_sessions_user_id"/>
            <dropTable tableName="chat_sessions"/>
        </rollback>
    </changeSet>

    <!-- chat_messages — one row per message in a session (user or assistant turn). -->
    <changeSet id="20261005100001-create-chat-messages-table" author="iqkv">
        <createTable tableName="chat_messages">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_chat_messages_session"
                             references="chat_sessions(id)"
                             deleteCascade="true"/>
            </column>
            <column name="role" type="VARCHAR(20)">
                <!-- USER | ASSISTANT | SYSTEM -->
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="chat_messages" indexName="idx_chat_messages_session_id">
            <column name="session_id"/>
        </createIndex>
        <createIndex tableName="chat_messages" indexName="idx_chat_messages_created_at">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="chat_messages" indexName="idx_chat_messages_created_at"/>
            <dropIndex tableName="chat_messages" indexName="idx_chat_messages_session_id"/>
            <dropTable tableName="chat_messages"/>
        </rollback>
    </changeSet>

    <!-- Fix FK: add ON DELETE CASCADE so deleting a session removes its messages. -->
    <changeSet id="20261005100002-fk-chat-messages-cascade-delete" author="iqkv">
        <dropForeignKeyConstraint baseTableName="chat_messages"
                                  constraintName="fk_chat_messages_session"/>
        <addForeignKeyConstraint baseTableName="chat_messages"
                                 baseColumnNames="session_id"
                                 constraintName="fk_chat_messages_session"
                                 referencedTableName="chat_sessions"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="chat_messages"
                                      constraintName="fk_chat_messages_session"/>
            <addForeignKeyConstraint baseTableName="chat_messages"
                                     baseColumnNames="session_id"
                                     constraintName="fk_chat_messages_session"
                                     referencedTableName="chat_sessions"
                                     referencedColumnNames="id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
